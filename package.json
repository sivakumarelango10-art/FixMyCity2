{
  "name": "fixmycity",
  "version": "1.0.0",
  "private": true,
  "description": "FixMyCity — One City. One Platform. Every Service. Modern mobile-first civic services application.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"prisma/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "storage:cleanup": "tsx scripts/storage-cleanup.ts",
    "env:check": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@hookform/resolvers": "^3.10.0",
    "@phosphor-icons/react": "^2.1.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "leaflet": "^1.9.4",
    "motion": "^12.4.7",
    "next": "^16.4.0",
    "next-themes": "^0.4.4",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^16.4.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
