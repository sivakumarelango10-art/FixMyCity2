# ==============================================================================
# FixMyCity - Environment Configuration Template (.env.example)
#
# Follows FixMyCity Master Build Prompt V3 Architecture:
# Single Next.js app, Supabase Auth + Storage + Realtime, Prisma with PostgreSQL.
# ==============================================================================

# Public — may appear in browser bundles
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
DATABASE_URL="postgresql://postgres:password@localhost:5433/fixmycity?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5433/fixmycity?schema=public"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STORAGE_BUCKET=complaint-photos
DEMO_PASSWORD=SET_ONLY_FOR_ISOLATED_DEMO_OR_LOCAL_DEVELOPMENT
DEMO_MODE=true
DEMO_PROJECT_ISOLATED=false
APP_ENV=development
